# ──────────────────────────────────────────────────────────────────────────────
# ORSD Crawler — Multi-stage build (workspace-safe)
# ──────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS base
WORKDIR /app

# ── builder stage ─────────────────────────────────────────────────────────────
FROM base AS builder

# Install workspace root + crawler deps first (layer caching)
COPY package.json package-lock.json ./
COPY packages/crawler/package.json packages/crawler/package.json
RUN npm install

# Copy crawler source and build
COPY packages/crawler/ packages/crawler/
RUN npm -w packages/crawler run build

# Prune dev dependencies
RUN npm prune --omit=dev

# ── production stage ──────────────────────────────────────────────────────────
FROM base

COPY --from=builder /app/packages/crawler/dist /app/dist
COPY --from=builder /app/packages/crawler/package.json /app/package.json
COPY --from=builder /app/node_modules /app/node_modules

USER node
CMD ["node", "dist/index.js"]
