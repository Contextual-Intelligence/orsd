# ──────────────────────────────────────────────────────────────────────────────
# ORSD — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in your values. Never commit .env to git.

# Dgraph
DGRAPH_URL=http://localhost:8080

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# API
PORT=3003

# Crawler
CRAWL_INTERVAL_HOURS=24
MAX_SIGNALS_PER_SOURCE=5000
ORSD_USER_AGENT=ORSD-Crawler/0.1

# MFDS (South Korea) — register at https://data.go.kr
MFDS_API_KEY=

# TGA (Australia) — optional API key
TGA_API_KEY=

# Webhook (monorepo integration) — POST /webhooks/orsd/signal-ingested
# WEBHOOK_URL=http://localhost:3000/webhooks/orsd/signal-ingested
